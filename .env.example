# Public browser configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_MAPBOX_TOKEN=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Server-only configuration. Never prefix these with NEXT_PUBLIC_.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Restricted Stripe Identity results key with access to recent detailed results.
# Used only to read the verified Driver License expiration date.
STRIPE_IDENTITY_RESTRICTED_KEY=
# Billing endpoints require a separate webhook secret and trusted return origin.
STRIPE_BILLING_WEBHOOK_SECRET=
BILLING_APP_URL=
STRIPE_CONNECT_ENABLED=false
STRIPE_CONNECT_WEBHOOK_SECRET=
STRIPE_BANK_PAYMENTS_ENABLED=false
# Use an active portal configuration with payment-method updates enabled and
# subscription updates disabled; account freeze is managed by Seatbelt.
STRIPE_PORTAL_CONFIGURATION_ID=
STRIPE_PRICE_BRONZE=
STRIPE_PRICE_SILVER=
STRIPE_PRICE_GOLD=
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
APP_URL=
DRIVER_ELIGIBILITY_DOCUMENT_RETENTION_DAYS=30
